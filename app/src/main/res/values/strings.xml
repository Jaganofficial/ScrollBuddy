    <string name="a11y_service_label">Vaathi ride-uhh!</string>
    <string name="a11y_service_summary">Counts your swipes through Reels and Shorts</string>
    <string name="a11y_service_description">Notices when you open Instagram or YouTube, and when you swipe from one video to the next in Reels and Shorts. It shows a small count of today\'s swipes while you swipe, and a character over the screen when you reach the limit you set. It receives events from those two apps only: a window of theirs coming to the front, and something scrolling. It can\'t read your screen, and nothing leaves your phone.</string>

    <string name="app_instagram">Instagram Reels</string>
    <string name="app_youtube">YouTube Shorts</string>

