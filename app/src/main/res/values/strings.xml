    <string name="nudge_title">Vaathi ride-uhh!</string>
    <!-- The character's lines, in Tamil as it is typed in chat. Each takes the address term
         as %1$s. -->
    <string-array name="nudge_lines">
        <item>Podhum, %1$s. Phone-a keezha vai.</item>
        <item>I am waiting, %1$s… andha phone keezha pora varaikkum.</item>
        <item>Oru thadava mudivu pannitten, %1$s: reels podhum.</item>
        <item>Power phone-la illa, %1$s. Adha keezha vekkura kai-la irukku.</item>
        <item>Yaarum paakala-nu nenachiya, %1$s? Vaathi inga dhaan irukken.</item>
        <item>Life is very short, %1$s. Adha reels-la tholaikkaadha.</item>
        <item>Class mudinjiduchu, %1$s. Phone-a ulla vai.</item>
        <item>Vaathi coming-nu sonnen la, %1$s? Vandhutten.</item>
    </string-array>
    <!-- His lines when no reels at all are allowed -->
    <string-array name="nudge_lines_zero">
        <item>Innaiku zero reels-nu neeye sonna, %1$s. Sonna sol thavara koodadhu.</item>
        <item>Oru reel kooda venaam, %1$s. Adhu dhaan namma deal.</item>
        <item>Innaiku leave, %1$s. Reels-ku, shorts-ku, rendukkume.</item>
    </string-array>
